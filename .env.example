# References only. Provision/reuse existing credentials separately on the authorized PC.
# Never copy real credentials or full account numbers into Git.
TOSS_WIFE_ACCESS_TOKEN=<existing-wife-token-reference>
TOSS_WIFE_CLIENT_ID=<existing-wife-client-reference>
TOSS_WIFE_CLIENT_SECRET=<existing-wife-secret-reference>
TOSS_WIFE_ACCOUNT_SUFFIX=<verified-four-digits>
TOSS_WIFE_ACCOUNT_SHA256=<verified-sha256-of-exact-accountNo-string>
TOSS_HUSBAND_ACCESS_TOKEN=<existing-husband-token-reference>
TOSS_HUSBAND_CLIENT_ID=<existing-husband-client-reference>
TOSS_HUSBAND_CLIENT_SECRET=<existing-husband-secret-reference>
TOSS_HUSBAND_ACCOUNT_SUFFIX=<verified-four-digits>
TOSS_HUSBAND_ACCOUNT_SHA256=<verified-sha256-of-exact-accountNo-string>
# Use an existing token OR existing client references with explicit --issue-token.
# Server read configuration needs only verified suffix/hash mappings, never these API tokens.
