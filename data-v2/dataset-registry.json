{
    "schemaVersion": 1,
    "datasets": {
        "identity": {
            "owner": "reference-data",
            "fields": ["listing"],
            "identityPolicy": "discovery_candidates_only"
        },
        "fund-profile": {
            "owner": "fund-data",
            "fields": ["prospectusExpenseRatio"]
        },
        "fund-observations": {
            "owner": "fund-data",
            "fields": [
                "nav",
                "aum",
                "sharesOutstanding",
                "closingPrice",
                "medianSpread30D",
                "secYield30D",
                "trailingYield12M"
            ]
        },
        "holdings": {
            "owner": "fund-data",
            "fields": ["position"]
        },
        "fx": {
            "owner": "reference-data",
            "fields": ["referenceRate"]
        },
        "filings": {
            "owner": "issuer-data",
            "fields": ["filing"]
        },
        "market-prices": {
            "owner": "market-data",
            "managedBy": "existing_price_collectors",
            "state": "supplier_rights_and_adjustment_contract_required"
        },
        "actions": {
            "owner": "market-data",
            "managedBy": "corporate_action_observations",
            "state": "verified_source_expansion_required"
        },
        "distributions": {
            "owner": "official-dividends",
            "managedBy": "scripts/data_v2/prepare_incremental_candidate.py",
            "state": "existing_authoritative_pipeline"
        },
        "tax-character": {
            "owner": "fund-tax-data",
            "managedBy": "scripts/content_pipeline/tax_character.py",
            "state": "existing_observation_pipeline"
        },
        "financials": {
            "owner": "issuer-data",
            "state": "taxonomy_period_and_authentication_contract_required"
        },
        "exposures": {
            "owner": "fund-data",
            "state": "position_coverage_and_method_contract_required"
        },
        "macro": {
            "owner": "reference-data",
            "state": "series_and_vintage_contract_required"
        },
        "analytics": {
            "owner": "analytics",
            "state": "input_release_vector_required"
        }
    },
