{
    "name": "etf",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "data:audit-size": "python scripts/data_pipeline/compact_history.py",
        "data:compact": "python scripts/data_pipeline/compact_history.py --apply",
        "data:register": "python scripts/data_pipeline/register_history.py",
        "data:repair-splits": "python scripts/data_pipeline/repair_split_types.py --apply",
        "add:etf": "python scripts/utils/add_etfs_by_provider.py",
        "backfill-market-cap": "python scripts/data_pipeline/backfill_market_cap_approximate.py",
        "generate-nav": "node tasks/generateNav.js",
        "generate-sidebar-tickers": "python scripts/utils/generateSidebar.py",
        "generate-calendar-events": "node tasks/generateCalendarEvents.js",
        "fetch-logos": "node tasks/fetchMissingLogos.js",
        "watch-nav": "nodemon --watch public/nav --ext json --exec \"npm run generate-nav\"",
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "type-check": "vue-tsc --noEmit",
        "add-ipo-dates": "node tasks/addIpoDatesToNav.js",
        "migrate:assets": "node scripts/migration/migrateAssets.js",
        "migrate:assets:dry": "node scripts/migration/migrateAssets.js --dry-run",
        "preview": "vite preview",
        "build:android": "vue-tsc --noEmit && vite build && npx cap sync android",
        "open:android": "npx cap open android",
        "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
        "lint:eslint": "eslint . --fix",
        "lint": "npm-run-all lint:*",
        "format:changed": "bash scripts/utils/format_changed_files.sh",
        "format:changed:win": "powershell -ExecutionPolicy Bypass -File scripts/format_changed_files.ps1",
        "format:data": "prettier --write \"public/data/**/*.json\" --log-level=warn",
        "format:nav": "prettier --write \"public/nav/**/*.json\" --log-level=warn",
        "format:calendar": "prettier --write \"public/calendar/**/*.json\" --log-level=warn",
        "format:nav.json": "prettier --write \"public/nav.json\" --log-level=warn",
        "format:public": "prettier --write \"public/*.json\" --log-level=warn",
        "format": "prettier --write src/ --log-level=warn",
        "data:sort-keys": "node tasks/sortDataKeys.js",
        "content:init": "python scripts/content_pipeline/manage.py init-db",
        "content:dashboard": "python scripts/content_pipeline/export_dashboard.py",
        "content:generate": "python scripts/content_pipeline/generate_content.py",
        "content:images": "node scripts/content_pipeline/render_content_images.mjs",
        "content:calendar": "python scripts/content_pipeline/content_calendar.py",
        "content:notion:dry": "python scripts/content_pipeline/sync_notion.py --dry-run",
        "content:notion": "python scripts/content_pipeline/sync_notion.py",
        "content:notion:apply": "python scripts/content_pipeline/sync_notion.py --apply",
        "content:run": "python scripts/content_pipeline/pipeline.py",
        "content:refresh": "python scripts/content_pipeline/refresh.py",
        "content:render-event": "node scripts/content_pipeline/render_public_event.mjs",
        "content:reconcile": "python scripts/content_pipeline/reconcile_public_data.py",
        "content:schedule:install": "powershell -ExecutionPolicy Bypass -File scripts/content_pipeline/install-schedule.ps1",
        "content:weekly": "python scripts/content_pipeline/weekly_digest.py",
        "content:performance": "python scripts/content_pipeline/performance.py import",
        "content:recommend": "python scripts/content_pipeline/performance.py recommend"
    },
    "dependencies": {
        "@capacitor/android": "^8.3.1",
        "@capacitor/core": "^8.3.1",
        "@fullcalendar/core": "^6.1.19",
        "@fullcalendar/daygrid": "^6.1.19",
        "@fullcalendar/google-calendar": "^6.1.19",
        "@fullcalendar/interaction": "^6.1.19",
        "@fullcalendar/list": "^6.1.19",
        "@fullcalendar/vue3": "^6.1.19",
        "@primeuix/themes": "^1.2.3",
        "@primevue/core": "^4.3.7",
        "@sentry/vue": "^10.27.0",
        "@vercel/analytics": "^1.5.0",
        "@vueuse/head": "^2.0.0",
        "axios": "^1.12.2",
        "date-fns": "^4.1.0",
        "echarts": "^5.6.0",
        "firebase": "^12.1.0",
        "formidable": "^3.5.4",
        "html2canvas": "^1.4.1",
        "image-size": "^1.1.1",
        "jszip": "^3.10.1",
        "p-limit": "^7.2.0",
        "playwright": "^1.56.1",
        "primeflex": "^4.0.0",
        "primeicons": "^7.0.0",
        "primevue": "^4.3.7",
        "terser": "^5.44.0",
        "ufo": "^1.6.1",
        "vue": "^3.5.19",
        "vue-echarts": "^7.0.3",
        "vue-router": "^4.5.1",
        "web-streams-polyfill": "^4.0.0"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.3.1",
        "@eslint/js": "^9.34.0",
        "@primevue/auto-import-resolver": "^4.3.7",
        "@types/node": "^24.10.1",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/eslint-config-prettier": "^10.2.0",
        "cheerio": "^1.0.0",
        "eslint": "^9.34.0",
        "eslint-plugin-oxlint": "~1.12.0",
        "eslint-plugin-vue": "~10.4.0",
        "firebase-admin": "^13.6.0",
        "gh-pages": "^6.3.0",
        "globals": "^16.3.0",
        "nodemon": "^3.1.10",
        "npm-run-all": "^4.1.5",
        "oxlint": "~1.83.0",
        "prettier": "3.6.2",
        "sass": "^1.90.0",
        "sass-embedded": "^1.90.0",
        "typescript": "^5.9.3",
        "unplugin-auto-import": "^20.0.0",
        "unplugin-vue-components": "^29.0.0",
        "vite": "^7.1.3",
        "vite-plugin-vue-devtools": "^8.0.0",
        "vue-tsc": "^3.1.5",
        "yahoo-finance2": "^2.13.3"
    }
}
